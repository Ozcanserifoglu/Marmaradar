# Copy to .env for local overrides. Never commit .env with real values.
#
# Local docker-compose (default dev credentials — not used in production):
DATABASE_URL=postgres://radar:radar@127.0.0.1:5433/radar_alert?sslmode=disable
PORT=8080

# JWT signing secret — use a long random string in production (set on the server, not here).
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Optional: enables Snap to Roads on drive upload (server-side). Leave empty to store raw GPS only.
# GOOGLE_MAPS_API_KEY=

# Restrict API clients to these countries (ISO 3166-1 alpha-2). Empty = no geo filter.
# Private/loopback IPs are always allowed (Docker, local dev).
GEO_RESTRICT_COUNTRIES=TR

# Production (set on the GCP VM / Cloud Run env, never in git):
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# JWT_SECRET=<long-random-secret>
# GOOGLE_MAPS_API_KEY=<maps-key-with-roads-api-enabled>
# GEO_RESTRICT_COUNTRIES=TR
