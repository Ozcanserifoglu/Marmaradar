# Docs-only subdomain — does NOT expose /v1/*
api.marmaradar.com {
	# Scalar UI at root
	handle / {
		rewrite * /docs
		reverse_proxy localhost:8081
	}

	handle /docs* {
		reverse_proxy localhost:8081
	}

	handle /openapi.json {
		reverse_proxy localhost:8081
	}

	# Block everything else (belt-and-suspenders; KrakenD won't route /v1 anyway
	# unless explicitly listed, but this prevents accidental future exposure)
	handle {
		respond "Not Found" 404
	}
}
