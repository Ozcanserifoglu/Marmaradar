# Docs-only subdomain — does NOT expose /v1/*
api.marmaradar.com {
	# OpenAPI spec (Scalar loads this)
	handle /openapi.json {
		reverse_proxy localhost:8081
	}

	# Docs UI at /docs and legacy paths
	handle /docs* {
		reverse_proxy localhost:8081
	}

	# Root serves the same Scalar UI (no rewrite — backend handles GET /)
	handle / {
		reverse_proxy localhost:8081
	}

	# Block everything else (KrakenD also whitelists paths only)
	handle {
		respond "Not Found" 404
	}
}
