{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "radar-alert-gateway",
  "port": 8080,
  "timeout": "30s",
  "cache_ttl": "0s",
  "extra_config": {
    "router": {
      "forwarded_by_client_ip": false
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "https://marmaradar.com",
        "https://www.marmaradar.com",
        "https://api.marmaradar.com"
      ],
      "allow_methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Accept",
        "Authorization",
        "Content-Type",
        "Origin"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "max_age": "12h",
      "allow_credentials": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "input_headers": ["CF-Connecting-IP"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["CF-Connecting-IP"],
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/docs",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["CF-Connecting-IP"],
      "backend": [
        {
          "url_pattern": "/docs",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/docs/",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/docs/",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/openapi.json",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["CF-Connecting-IP"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 20,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/openapi.json",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/reset-password",
      "method": "GET",
      "input_headers": ["CF-Connecting-IP"],
      "output_encoding": "no-op",
      "input_query_strings": ["token"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 40,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/reset-password",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/cameras/nearby",
      "method": "GET",
      "input_headers": ["CF-Connecting-IP"],
      "output_encoding": "no-op",
      "input_query_strings": ["lat", "lon", "radius_m", "region"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
