{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "radar-alert-gateway",
  "port": 8080,
  "timeout": "30s",
  "cache_ttl": "0s",
  "extra_config": {
    "router": {
      "forwarded_by_client_ip": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/reset-password",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["token"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 40,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/reset-password",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/cameras/nearby",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["lat", "lon", "radius_m", "region"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/cameras/nearby",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/corridors/nearby",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["lat", "lon", "region"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/corridors/nearby",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/sync",
      "method": "GET",
      "output_encoding": "no-op",
      "input_query_strings": ["region", "bbox", "since"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/sync",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 10,
          "client_capacity": 5,
          "every": "1m",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/register",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 10,
          "client_capacity": 5,
          "every": "1m",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/login",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/refresh",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/refresh",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/oauth",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 10,
          "client_capacity": 5,
          "every": "1m",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/oauth",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/forgot-password",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "client_max_rate": 3,
          "client_capacity": 3,
          "every": "1m",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/forgot-password",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/auth/reset-password",
      "method": "POST",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 30,
          "client_max_rate": 5,
          "client_capacity": 5,
          "every": "1m",
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/auth/reset-password",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/drives",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/drives",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/drives",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/drives",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/drives/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/drives/{id}",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/drives/{id}",
      "method": "PATCH",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/drives/{id}",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/users/me/stats",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/users/me/stats",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/reports",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/reports",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/reports/{id}/votes",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 80,
          "client_max_rate": 8,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/reports/{id}/votes",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/live-reports",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 50,
          "client_max_rate": 5,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/live-reports",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/live-reports/active",
      "method": "GET",
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 100,
          "client_max_rate": 10,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/live-reports/active",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/eta/cameras",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 6,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/eta/cameras",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/amenities/cells",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 60,
          "client_max_rate": 6,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/amenities/cells",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/tts/speak",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 40,
          "client_max_rate": 4,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/tts/speak",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    },
    {
      "endpoint": "/v1/tts/catalog",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Authorization"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 40,
          "client_max_rate": 4,
          "strategy": "ip"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/tts/catalog",
          "encoding": "no-op",
          "host": {{ marshal .backend.host }}
        }
      ]
    }
  ]
}
