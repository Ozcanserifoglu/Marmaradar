# Go
**/bin/
**/*.exe
**/*.test

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
#mobile/pubspec.lock

# IDE / local dev (keep on disk, never push to GitHub)
.idea/
.vscode/
.cursor/
*.iml
scripts/run-local-mobile.sh

# Cursor AI Rules
.cursorrules

# OS
.DS_Store
Thumbs.db

# Env — never commit real credentials
.env
.env.*
!.env.example
!.env.local.example
!**/.env.example

# Secrets / signing / local credentials
**/*.keystore
**/*.jks
**/*.pem
**/*.p12
**/key.properties
**/google-services.json
**/GoogleService-Info.plist
secrets.txt
**/secrets.txt

# Data
*.db

# Bulky map extracts (Geofabrik downloads etc.) — far over GitHub's 100 MB
# limit, always re-downloadable via scripts/import-turkey.ps1
*.osm.pbf
*.osm.bz2
*.osm
