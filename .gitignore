# Go
**/bin/
**/*.exe
**/*.test

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
#mobile/pubspec.lock

# IDE / local dev (keep on disk, never push to GitHub)
.idea/
.vscode/
.cursor/
*.iml
scripts/run-local-mobile.sh

# Cursor AI Rules
.cursorrules

# OS
.DS_Store
Thumbs.db

# Env — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Secrets / signing
**/*.keystore
**/*.jks
**/key.properties
**/google-services.json
**/GoogleService-Info.plist

# Data
*.db

# Bulky map extracts (Geofabrik downloads etc.) — far over GitHub's 100 MB
# limit, always re-downloadable via scripts/import-turkey.ps1
*.osm.pbf
*.osm.bz2
*.osm
