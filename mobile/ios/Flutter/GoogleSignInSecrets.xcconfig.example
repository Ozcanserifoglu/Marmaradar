// Copy to GoogleSignInSecrets.xcconfig (gitignored locally if desired) after creating
// the iOS OAuth client in Google Cloud Console.
//
// GOOGLE_IOS_CLIENT_ID is the full iOS client ID, e.g.
//   123456789-abcdef.apps.googleusercontent.com
// GOOGLE_IOS_URL_SCHEME is the reversed client ID, e.g.
//   com.googleusercontent.apps.123456789-abcdef

GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
